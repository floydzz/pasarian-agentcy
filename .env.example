# Copy to .env. Docker Compose reads this file too, so the providers and keys
# below configure the container as well as a native run — except DATABASE_URL
# and CHROMA_PATH, which compose sets itself for the container network.

# --- Database ---
DATABASE_URL=mysql+pymysql://agentcy:agentcy_pw@127.0.0.1:3308/agentcy

# --- LLM provider: claude | openai | qwen | demo ---
# `demo` runs the whole pipeline offline with canned copy — no key, no cost.
# Use it to rehearse; see backend/README.md.
LLM_PROVIDER=claude
# Let the model think before it answers. Off by default: DashScope ships Qwen3
# with hidden reasoning on, which measured 82% of every completion for a 5.6x
# latency penalty (17.8x on the vision pass) with no gain in answer quality.
LLM_REASONING=false
# Tried in order when the model in use reports its free quota spent.
# DashScope meters per model, so a sibling usually still answers.
LLM_FALLBACK_MODELS=qwen3.6-plus
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Model overrides (optional — sensible defaults per provider)
# Qwen note: structured output (json_schema) is only supported by the
# 3.7-plus/flash and 3.7/3.8-max series. `qwen-max` returns a 400, and every
# agent here depends on it, so pin a model rather than relying on an alias.
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4.1
QWEN_MODEL=qwen3.7-plus

# The vision QA pass sends an image. Leave blank to reuse the model above —
# only set this if the text model cannot accept images.
CLAUDE_VISION_MODEL=
OPENAI_VISION_MODEL=
QWEN_VISION_MODEL=

# --- Embeddings: openai | qwen | demo ---
# Switching this means re-ingesting: rm -rf backend/.chroma
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- Chroma ---
CHROMA_PATH=.chroma

# --- Media generation: dashscope | demo ---
# `demo` renders deterministic offline placeholders — no key, no cost.
# dashscope reuses DASHSCOPE_API_KEY above; it needs no key of its own.
MEDIA_PROVIDER=demo
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
ASSETS_PATH=data/assets

# --- Trends ---
SERPAPI_KEY=
TRENDS_GEO=MY
TEST_DATABASE_URL=mysql+pymysql://agentcy:agentcy_pw@127.0.0.1:3308/agentcy_test
