# --- Database ---
DATABASE_URL=mysql+pymysql://agentcy:agentcy_pw@127.0.0.1:3307/agentcy

# --- LLM provider: claude | openai | qwen ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# Model overrides (optional — sensible defaults per provider)
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4.1
QWEN_MODEL=qwen-max

# --- Embeddings: openai | qwen ---
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- Chroma ---
CHROMA_PATH=.chroma

# --- Trends ---
SERPAPI_KEY=
TRENDS_GEO=MY
TEST_DATABASE_URL=mysql+pymysql://agentcy:agentcy_pw@127.0.0.1:3307/agentcy_test
